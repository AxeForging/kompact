{
  "name": "laya-compact",
  "version": "0.1.0",
  "description": "Laya-scored context compaction for coding agents. Local, offline, no API key.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.all.json && tsc -p tsconfig.hooks.json",
    "test": "vitest run",
    "eval": "bun eval/extract-labels.ts && bun eval/baseline.ts",
    "validate": "claude plugin validate .claude-plugin/plugin.json",
    "serve": "bun bin/laya-compact-serve.ts",
    "calibrate": "bun eval/extract-labels.ts && bun eval/calibrate.ts",
    "dry-run": "bun eval/sessions.ts",
    "eval:results": "bun eval/results.ts",
    "eval:ci": "bun eval/repeat.ts --fixture && bun eval/policy.ts --fixture && bun eval/recovery.ts --fixture && bun eval/outcome.ts --fixture",
    "eval:fixtures": "bun eval/make-fixture.ts && bun eval/make-session-fixture.ts",
    "prepack": "npm run build",
    "docs:demo": "bun eval/demo.ts",
    "docs:eval": "bun eval/make-eval-page.ts",
    "docs": "bun eval/demo.ts && bun eval/distribution.ts && bun eval/make-eval-page.ts",
    "eval:fit": "bun eval/fit.ts",
    "eval:score": "bun eval/score.ts",
    "eval:truncation": "bun eval/truncation.ts",
    "docs:plot": "bun eval/distribution.ts",
    "docs:check": "bun eval/render-check.ts",
    "smoke": "bun test/live-smoke.ts",
    "ckpt": "bun test/ckpt-compare.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "bin": {
    "laya-compact-serve": "./dist/bin/laya-compact-serve.js"
  },
  "author": "AxeForging",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxeForging/laya-compact.git"
  },
  "bugs": {
    "url": "https://github.com/AxeForging/laya-compact/issues"
  },
  "homepage": "https://github.com/AxeForging/laya-compact#readme",
  "keywords": [
    "claude-code",
    "codex",
    "context",
    "compaction",
    "plugin",
    "llm",
    "agent"
  ]
}
